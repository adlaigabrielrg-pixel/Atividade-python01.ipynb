import tkinter as tk

def realizar_divisao():
    try:
        # Captura os valores dos campos de texto (Entry)
        num1_str = entry_dividendo.get()
        num2_str = entry_divisor.get()
        
        # Tenta converter os valores para float (captura erro de letras ou vazio)
        dividendo = float(num1_str)
        divisor = float(num2_str)
        
        # Realiza a divisão (captura erro de divisão por zero)
        resultado = dividendo / divisor
        
        # Exibe o resultado formatado no Label
        label_resultado.config(text=f"Resultado: {resultado:.2f}", fg="green")
        
    except ValueError:
        # Erro caso o usuário digite letras, símbolos ou deixe o campo em branco
        label_resultado.config(text="Erro: Digite apenas números válidos!", fg="red")
        
    except ZeroDivisionError:
        # Erro caso o divisor seja zero
        label_resultado.config(text="Erro: Não é possível dividir por zero!", fg="red")

# Configuração da janela principal da aplicação
janela = tk.Tk()
janela.title("Calculadora à Prova de Erro")
janela.geometry("350x250")

# Elementos da Interface Gráfica (Labels, Entries e Button)
label_instrucao = tk.Label(janela, text="Calculadora de Divisão", font=("Arial", 12, "bold"))
label_instrucao.pack(pady=10)

# Campo do Dividendo
label_dividendo = tk.Label(janela, text="Dividendo:")
label_dividendo.pack()
entry_dividendo = tk.Entry(janela)
entry_dividendo.pack(pady=5)

# Campo do Divisor
label_divisor = tk.Label(janela, text="Divisor:")
label_divisor.pack()
entry_divisor = tk.Entry(janela)
entry_divisor.pack(pady=5)

# Botão para executar a ação
botao_dividir = tk.Button(janela, text="Dividir", command=realizar_divisao)
botao_dividir.pack(pady=10)

# Rótulo destinado a mostrar o resultado ou as mensagens de erro
label_resultado = tk.Label(janela, text="", font=("Arial", 10, "bold"))
label_resultado.pack(pady=10)

# Inicia o loop principal da interface gráfica
janela.mainloop()
